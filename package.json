{
  "name": "entrosana-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "node server.mjs",
    "deploy": "astro build && systemctl --user restart entrosana-site",
    "deploy:pages": "astro build && echo 'push to master to publish GitHub Pages (entrosana.com)'"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.3",
    "@fontsource/carlito": "^5.3.0",
    "astro": "^5.6.1",
    "preact": "^10.29.8",
    "sirv": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
