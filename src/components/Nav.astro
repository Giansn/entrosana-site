---
// Server side of the header: resolves URLs (base path) and the current page,
// then hands plain data to the SiteNav island.
import SiteNav from "./islands/SiteNav";
import { href, nav, pagePath } from "../lib/site";

const current = pagePath(Astro.url);
const links = nav.map((l) => ({ href: href(l.href), label: l.label, current: current === l.href }));
---
<SiteNav
  client:load
  home={href("/")}
  homeCurrent={current === "/"}
  links={links}
  cta={{ href: href("/request-access/"), label: "Request access", current: current === "/request-access/" }}
/>
