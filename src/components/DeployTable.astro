---
// Where it runs: one axis — how much of the stack you hold. A real table, so
// it reads in order with a screen reader and compares at a glance; on phones
// each tier becomes a labelled block.
const tiers = [
  { name: "Hosted", docs: "Swiss/EU", model: "CH/EU or USA", storage: "Swiss/EU" },
  { name: "Hybrid", docs: "on site", model: "on site", storage: "Swiss/EU" },
  { name: "On-premises", docs: "your hardware", model: "your hardware", storage: "your hardware" },
];
---
<div class="dt">
  <table>
    <caption class="vh">Where documents, the model and storage sit in each tier</caption>
    <thead>
      <tr>
        <th scope="col">Tier</th>
        <th scope="col">Documents</th>
        <th scope="col">Model</th>
        <th scope="col">Storage</th>
      </tr>
    </thead>
    <tbody>
      {tiers.map((t) => (
        <tr>
          <th scope="row">{t.name}</th>
          <td data-label="Documents">{t.docs}</td>
          <td data-label="Model">{t.model}</td>
          <td data-label="Storage">{t.storage}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style is:global>
/* DeployTable — drawn as the live /service/ figure ("Where it runs", SVG
   viewBox 690×340 in a .diagram box). One --u is one SVG unit: at 1440
   1u = 1.575px → 15.75px column labels, 18.9px tier names, 220×69px cells. */

.dt {
  container: dt / inline-size;
  --u: calc(100cqi / 690);
  margin-top: 2.4rem;                                       /* 38.4px */
  padding: clamp(.9rem, .5rem + 1.5vw, 1.6rem);             /* 25.6px */
  border: 1px solid var(--line);
  border-radius: 14px;
  background: color-mix(in srgb, var(--surface) 55%, transparent);
  overflow: hidden;
}
.dt table { width: 100%; border-collapse: collapse; }
.dt th, .dt td { padding: 0; border: 0; background: none; text-align: left; font-weight: 400; }

@container dt (min-width: 619px) {
  .dt table, .dt thead, .dt tbody { display: block; }
  .dt tr {
    position: relative;
    display: grid;
    grid-template-columns: calc(80 * var(--u)) repeat(3, calc(140 * var(--u)));
    column-gap: calc(40 * var(--u));                        /* cells at x 140 · 320 · 500 */
    padding-left: calc(20 * var(--u));                      /* tier names at x 20 */
  }
  /* column labels: SVG text.small, y 24 */
  .dt thead tr { height: calc(52 * var(--u)); align-items: start; }
  .dt thead th {
    padding: calc(16 * var(--u)) 0 0 calc(10 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(10 * var(--u));
    line-height: 1;
    letter-spacing: normal;
    text-transform: uppercase;
    color: var(--muted);
  }
  .dt thead th:first-child { clip-path: inset(50%); }      /* "Tier": live shows no label here */
  /* rows: 44u cells, 110u pitch, 24u to the bottom edge */
  .dt tbody { padding-bottom: calc(24 * var(--u)); }
  .dt tbody tr { height: calc(44 * var(--u)); align-items: center; }
  .dt tbody tr + tr { margin-top: calc(66 * var(--u)); }
  /* tier name: SVG text.accent */
  .dt tbody th {
    font-family: var(--font-mono);
    font-size: calc(12 * var(--u));
    line-height: 1;
    letter-spacing: normal;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--seal);
  }
  /* cell: rect rx 5, stroke 2, fill --paper-2, label text.small at x+20 */
  .dt tbody td {
    display: flex;
    align-items: center;
    height: 100%;
    padding-left: calc(18 * var(--u));
    border: calc(2 * var(--u)) solid var(--line);
    border-radius: calc(5 * var(--u));
    background: var(--bg-2);
    font-family: var(--font-mono);
    font-size: calc(10 * var(--u));
    line-height: 1;
    color: var(--muted);
    white-space: nowrap;
  }
  /* what sits on your premises is drawn in seal: hybrid documents + model, everything on-premises */
  .dt tbody tr:nth-child(2) td:nth-of-type(-n + 2),
  .dt tbody tr:nth-child(3) td:nth-of-type(-n + 3) { border-color: var(--seal); }
  /* the premises boundary: dashed 2u line, 6u dash / 6u gap, 8u beyond the cells */
  .dt tbody tr::after {
    content: "";
    position: absolute;
    top: calc(-8 * var(--u));
    width: calc(2 * var(--u));
    height: calc(60 * var(--u));
    background: repeating-linear-gradient(to bottom, var(--seal) 0 calc(6 * var(--u)), transparent calc(6 * var(--u)) calc(12 * var(--u)));
  }
  .dt tbody tr:nth-child(1)::after {
    left: calc(119 * var(--u));
    background: repeating-linear-gradient(to bottom, var(--line) 0 calc(6 * var(--u)), transparent calc(6 * var(--u)) calc(12 * var(--u)));
  }
  .dt tbody tr:nth-child(2)::after { left: calc(479 * var(--u)); }
  .dt tbody tr:nth-child(3)::after { left: calc(659 * var(--u)); }
}

/* text ladder (live .diagram-mobile): mono, seal names, muted lines */
@container dt (max-width: 618.98px) {
  .dt table, .dt thead, .dt tbody, .dt tr, .dt th { display: block; }
  .dt thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .dt tbody { display: grid; gap: .35rem; }
  .dt tbody, .dt tbody th, .dt tbody td {
    font-family: var(--font-mono);
    font-size: var(--step--1);                              /* 12.62px at 390 */
    line-height: 1.6;
  }
  .dt tbody th { margin-bottom: .35rem; font-weight: 500; text-transform: uppercase; color: var(--seal); }
  .dt tbody td { display: inline; color: var(--muted); }
  .dt tbody td::before { content: attr(data-label) " "; text-transform: lowercase; }
  .dt tbody td + td::before { content: " · " attr(data-label) " "; }
}

</style>
