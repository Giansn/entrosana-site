---
import Mark from "./Mark.astro";
import { href, ext, MAIL } from "../lib/site";
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__brand">
      <a href={href("/")} class="foot__logo" aria-label="entrosana — home">
        <Mark size={30} />
        <span>entrosana</span>
      </a>
      <p>Adaptive solutions for educational organisations, from the ground up. Swiss/EU data residency by design.</p>
      <p><a href={`mailto:${MAIL}`}>{MAIL}</a></p>
    </div>
    <nav class="foot__cols" aria-label="Footer">
      <div>
        <h2 class="foot__h">Offer</h2>
        <ul>
          <li><a href={href("/service/")}>Back office</a></li>
          <li><a href={href("/modules/")}>Modules</a></li>
          <li><a href={href("/hub/")}>Hub</a></li>
          <li><a href={href("/service/#deploy")}>Where it runs</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot__h">Company</h2>
        <ul>
          <li><a href={href("/roadmap/")}>Roadmap</a></li>
          <li><a href={href("/request-access/")}>Request access</a></li>
          <li><a href={href("/imprint/")}>Imprint</a></li>
          <li><a href={href("/privacy/")}>Privacy</a></li>
          <li><a href={ext.source}>Source (AGPL-3.0)</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot__h">Residency &amp; language</h2>
        <ul class="foot__plain">
          <li>Switzerland / EU</li>
          <li>English · German · Spanish</li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="wrap foot__base">
    <span>© {year} entrosana</span>
    <span>Open source · AGPL-3.0</span>
  </div>
</footer>

<style>
.foot {
  --foot-ink: #E9EBE7;
  --foot-text: #c7cbd2;
  --foot-dim: #9298A3;
  --foot-hover: #FFFFFF;
  position: relative;
  margin-top: auto;
  padding-block: clamp(2.5rem, 1.5rem + 4vw, 4rem) 1.5rem;
  border-top: 1px solid var(--line);
  background: transparent;
  color: var(--foot-ink);
}
:global(:root[data-theme="light"]) .foot {
  --foot-ink: var(--ink);
  --foot-text: var(--ink-2);
  --foot-dim: #5A5E66;
  --foot-hover: var(--ink);
}
/* tapering seam between content and footer */
.foot::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(var(--wrap, 1140px), calc(100% - 3rem));
  height: 1px;
  pointer-events: none;
  background: linear-gradient(90deg, transparent,
    color-mix(in srgb, var(--seal) 26%, transparent) 18%,
    color-mix(in srgb, var(--seal) 26%, transparent) 82%, transparent);
}
:global(:root[data-theme="light"]) .foot::before {
  background: linear-gradient(90deg, transparent,
    color-mix(in srgb, var(--seal) 60%, transparent) 18%,
    color-mix(in srgb, var(--seal) 60%, transparent) 82%, transparent);
}

.foot__inner { display: grid; gap: 2.5rem; }
@media (min-width: 760px) { .foot__inner { grid-template-columns: 1.3fr 2fr; } }

/* brand lockup: same image as the header, one colour */
.foot__logo {
  display: inline-flex;
  align-items: center;
  gap: .34em;
  font-family: var(--font-mono);
  font-size: var(--step-1);
  font-weight: 400;
  color: var(--seal);
  text-decoration: none;
}
.foot__logo :global(svg) { width: 2.667em; height: 2.667em; flex: none; color: currentColor; }
.foot__logo > span { position: relative; }
.foot__logo > span::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -.28em;
  height: 2px;
  pointer-events: none;
  opacity: 0;
  transition: opacity .18s ease;
  background: linear-gradient(90deg, transparent,
    color-mix(in srgb, var(--seal) 65%, transparent) 22%,
    color-mix(in srgb, var(--seal) 65%, transparent) 78%, transparent);
  filter: drop-shadow(0 0 4px color-mix(in srgb, var(--seal) 55%, transparent));
}
.foot__logo:hover > span::after,
.foot__logo:focus-visible > span::after { opacity: 1; }
@media (prefers-reduced-motion: reduce) { .foot__logo > span::after { transition: none; } }

.foot__brand p { margin: .6rem 0 1rem; max-width: 38ch; color: var(--foot-dim); }
/* prototype-only mail line, in the footer link language */
.foot__brand p + p { font-size: var(--step--1); }
.foot__brand p a { color: var(--foot-text); text-decoration: none; }
.foot__brand p a:hover { color: var(--foot-hover); }

.foot__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
@media (min-width: 860px) {
  .foot__cols { position: relative; }
  .foot__cols::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -20px;
    transform: translate(-50%, -50%);
    width: 1px;
    height: min(70%, 8rem);
    pointer-events: none;
    background: linear-gradient(180deg, transparent,
      color-mix(in srgb, var(--seal) 34%, transparent) 24%,
      color-mix(in srgb, var(--seal) 34%, transparent) 76%, transparent);
  }
  :global(:root[data-theme="light"]) .foot__cols::before {
    background: linear-gradient(180deg, transparent,
      color-mix(in srgb, var(--seal) 65%, transparent) 24%,
      color-mix(in srgb, var(--seal) 65%, transparent) 76%, transparent);
  }
}
.foot__h {
  display: block;
  margin: .6rem 0 0;
  font-family: var(--font-mono);
  font-size: var(--step--1);
  font-weight: 400;
  line-height: 1.6;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--foot-dim);
}
.foot ul { list-style: none; margin: 0; padding: 0; }
.foot li a {
  display: block;
  margin-bottom: .45rem;
  font-size: var(--step--1);
  line-height: 1.6;
  color: var(--foot-text);
  text-decoration: none;
}
.foot li a:hover { color: var(--foot-hover); }
.foot__plain li {
  display: block;
  margin: .6rem 0 .45rem;
  font-size: var(--step--1);
  line-height: 1.6;
  color: var(--foot-text);
}

.foot__base {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  column-gap: 1rem;
  margin-top: 2.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--line-2, #525C70);
  font-size: var(--step--1);
}
:global(:root[data-theme="light"]) .foot__base { border-top-color: var(--line); }
.foot__base > span {
  margin-top: .6rem;
  font-family: var(--font-mono);
  line-height: 1.6;
  color: var(--foot-dim);
}
</style>
