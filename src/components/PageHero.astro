---
// Page header for subpages: what the page is (eyebrow), the point (h1), and
// one sentence of orientation. Optional actions and an aside panel.
interface Props { eyebrow: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
const hasAside = Astro.slots.has("aside");
---
<section class:list={["section ph", { "ph--aside": hasAside }]}>
  <div class="wrap ph__grid">
    <div class="ph__main">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="ph__h">{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {hasAside && <aside class="ph__aside"><slot name="aside" /></aside>}
  </div>
</section>

<style is:global>
/* PageHero — live page-hero.css + shapes.css §5 + site.css .ph/.ph__h. */

.section.ph { padding-bottom: clamp(2rem, 1rem + 3vw, 3rem); }        /* top = .section: 112px; bottom 48px */
.ph .ph__grid { display: block; }
.ph .ph__main > * { margin: 0; min-width: 0; }                        /* live .ph__col > * { margin: 0 } */
.ph .ph__main > .eyebrow { margin-bottom: 1.25rem; }                  /* 20px */

/* live .display.ph__h */
.ph .ph__h {
  max-width: 18ch;
  margin-bottom: 1.2rem;                                              /* 19.2px */
  font-family: var(--font-sans);
  font-size: clamp(1.9rem, 1.6rem + 1.6vw, 2.9rem);                   /* 46.4px; 31.84px at 390 */
  font-weight: 700;
  line-height: 1;
  letter-spacing: -.015em;
  color: var(--ink);
  text-wrap: wrap;
}
/* the text column (live .ph__col--b: a flex column, gap 1rem) */
.ph .ph__main > :not(.eyebrow):not(.ph__h) + :not(.eyebrow):not(.ph__h) { margin-top: 1rem; }
.ph .ph__main > .lede { color: var(--ink-2); }                         /* 22.4px / 1.6, max 56ch */

/* ── default: lopsided split (live [data-hero="lopsided"]) ── */
@media (min-width: 821px) {
  .ph:not(.ph--aside):not(:has(+ .legal-wrap)) .ph__main {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.45fr);        /* 391px | 691px at 1440 */
    grid-template-rows: auto auto auto auto 1fr;
    column-gap: clamp(2rem, 4vw, 4.5rem);                             /* 57.6px */
    align-items: start;
  }
  .ph:not(.ph--aside):not(:has(+ .legal-wrap)) .ph__main > .eyebrow { grid-column: 1 / -1; grid-row: 1; justify-self: start; }
  .ph:not(.ph--aside):not(:has(+ .legal-wrap)) .ph__main > .ph__h { grid-column: 1; grid-row: 2 / -1; max-width: 12ch; }    /* 282px */
  .ph:not(.ph--aside):not(:has(+ .legal-wrap)) .ph__main > :not(.eyebrow):not(.ph__h) {
    grid-column: 2;
    max-width: calc(var(--step-0) * 31.39);                           /* live 62ch of the body face = 527px */
  }
}

/* ── with an aside (live /hub/: even split, heading column left) ── */
@media (min-width: 821px) {
  .ph.ph--aside .ph__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;                                   /* 541px | 541px */
    column-gap: clamp(2rem, 4vw, 4.5rem);
    align-items: start;
  }
  .ph.ph--aside .ph__h { max-width: 14ch; }                           /* live .ph__col--a .ph__h */
  /* the aside starts level with the heading, under the full-width eyebrow line */
  .ph.ph--aside .ph__aside { margin-top: calc(var(--step--1) * 1.6 + 1.25rem); }   /* 42px */
}
/* ── roadmap: live hero is a plain section, heading at h2 size (.display.h2.deploy__h) ── */
.section.ph:has(.glance) { padding-bottom: 0; }
.ph:has(.glance) .ph__h {
  max-width: 24ch;                                                    /* 428px */
  margin-bottom: 2.5rem;                                              /* 40px */
  font-size: clamp(1.5rem, 1.3rem + 1.1vw, 2.2rem);                   /* 35.2px */
}
.ph:has(.glance) .lede {                                              /* live .surfaces__lede */
  max-width: 60ch;
  margin-bottom: 1.6rem;
  font-size: var(--step-0);                                           /* 16.8px */
  line-height: 1.6;
}

/* ── legal: one centred column (live .wrap.legal, max 70ch) ── */
.section.ph:has(+ .legal-wrap) { padding-bottom: 0; }
.ph:has(+ .legal-wrap) .ph__grid { max-width: 70ch; }                 /* 595px, centred by .wrap */
.ph:has(+ .legal-wrap) .ph__main > .lede { margin-bottom: 1rem; }

/* ── narrow: one column (live max-width 820) ── */
@media (max-width: 820px) {
  .ph .ph__h { max-width: none; }
}

</style>
