---
import Layout from "../layouts/Layout.astro";
import RecordChain from "../components/RecordChain.astro";
import HubStack from "../components/HubStack.astro";
import { href, ext } from "../lib/site";
---
<Layout>
  <!-- Hero: who it is for, the two promises (the classroom first), one primary action -->
  <section class="section hero">
    <div class="wrap hero__copy">
      <p class="eyebrow">For schools &amp; educational organisations</p>
      <h1 class="hero__h">
        <span>Enhance and extend learning.</span>
        <span class="hero__h2">Reduce administrative load.</span>
      </h1>
      <p class="lede">We bring adaptive learning modules to you, onsite or online. We design administrative work, accounting, contracts and the recurring tasks , in respect off the system you already use.</p>
      <div class="actions">
        <a class="btn" href={href("/request-access/")}>Request pilot access</a>
        <a class="link" href={href("/modules/#available")}>Try the first module</a>
      </div>
      <ul class="hero__facts" aria-label="Facts">
        <li>Modules online &amp; on site</li>
        <li>Swiss/EU residency</li>
        <li>Open source · AGPL&#8209;3.0</li>
        <li>Engine in development</li>
      </ul>
    </div>
  </section>

  <!-- What we do: two services, the classroom before the back office -->
  <section class="section" id="what">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2 class="h2">Two services: the classroom and the back office.</h2>
      <p class="intro">Both come in formats adapted to your needs. You can implement and self-host the modules and tools yourself; otherwise we guide, implement, host and maintain them for you.</p>
      <div class="grid grid--2">
        <article class="card card--link">
          <div class="card__head"><h3>Learning modules</h3><span class="chip chip--live">online &amp; on site</span></div>
          <p class="for">for a class, a family, or a single student</p>
          <p>Scoped and built on request by contributors in social work, nature-based and technical fields, matched to the age and size of the class. Delivered online, at your site, or both, with materials, transport and evaluation included where desired.</p>
          <a class="link" href={href("/modules/")}>See the modules</a>
        </article>
        <article class="card card--link">
          <div class="card__head"><h3>The back office</h3><span class="chip chip--open">as an engagement</span></div>
          <p class="for">for the work nobody went into education to do</p>
          <p>Accounting, contracts and the recurring administration around them, taken on with you and against the system you already run, whether that is CashCtrl, bexio or another. Scoped per organisation as a pilot. Decisions stay with your people; we do the work around them.</p>
          <a class="link" href={href("/service/")}>Back-office tooling</a>
        </article>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section band" id="how">
    <div class="wrap">
      <p class="eyebrow">How we work</p>
      <h2 class="h2">Built from the ground up,<br />not configured.</h2>
      <p class="human">Most solutions for educational organisations can only be configured.</p>
      <p class="human small">entrosana opens the room to decide what you need from the ground up: no tools full of functions nobody uses, and no learning tasks designed for repetitive mass learning.</p>
      <ol class="steps">
        <li>
          <h3>Tell us what you envision</h3>
          <p>Map out your specific needs, intended solutions and known obstacles. We take your instructions into account while we build your solution.</p>
        </li>
        <li>
          <h3>Review our suggestions</h3>
          <p>This is the time to make room for process optimisations, potential automations and mapping out the implementation.</p>
        </li>
        <li>
          <h3>Progressive adaptation</h3>
          <p>For us an implementation is never finished: the use case may stay while the options change, or the other way around. Want to maintain a solution yourself? Get in touch.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- The Hub + how data is handled (one column, figure at full width; the data figure itself lives on the back-office page) -->
  <section class="section" id="hub">
    <div class="wrap">
      <p class="eyebrow">One ground. What stands on it.</p>
      <h2 class="h2">The Hub, and what runs in it.</h2>
      <p class="intro">The Hub is the ground: shared identity, one sealed record, one licence. Modules run in the classroom on it; tools run the back office on it. Both leave the same trail, so what happened can be shown rather than asserted.</p>
      <HubStack />
      <div class="hub__text">
        <p>Students, parents and teachers work alongside outside contributors, in the open under AGPL-3.0. The Hub is being built at <a href={ext.hub}><b>entrosana.app</b></a>.</p>
        <div class="actions">
          <a class="btn btn--hub" href={ext.hub}>Open the Hub →</a>
          <a class="link" href={href("/hub/")}>Learn about the Hub</a>
        </div>
      </div>
      <article class="card datanote">
        <p class="eyebrow">How data is handled</p>
        <h3>Two model layers, by design.</h3>
        <p>Anything touching delicate records is designed to run on a model served on your own or our hardware. Only data that is not sensitive goes to an online provider. That boundary is what keeps data management local rather than merely promised.</p>
        <a class="link" href={href("/service/#data")}>How the two layers work</a>
      </article>
    </div>
  </section>

  <!-- Where we stand (live: a lopsided split that stacks) -->
  <section class="section band" id="status">
    <div class="wrap split split--stack">
      <div>
        <p class="eyebrow">Where we stand</p>
        <h2 class="h2">In development.<br />In the open.</h2>
      </div>
      <div>
        <p>entrosana is in development, and we say so wherever it matters. The engine behind the back-office tools is public under AGPL-3.0 and is not production software today. No school runs on the engine yet, and modules are delivered by people rather than by software. Pilot access is opening to a small group of Swiss organisations. The aim is systemic: an open service any school and any back office can inherit.</p>
        <p>Founded by Gianluca Kühne.</p>
        <ul class="status-list" aria-label="Status by part">
          <li><span class="what">Modules</span><span class="chip chip--live">online &amp; on site</span></li>
          <li><span class="what">Back-office workflows</span><span class="chip chip--dev">in development</span></li>
          <li><span class="what">Sign-in &amp; separation</span><span class="chip chip--built">built</span></li>
          <li><span class="what">Audit trail</span><span class="chip chip--built">built</span></li>
        </ul>
        <p>To see current prototypes, open the Arboro showcase, developed for our first collaboration partner.</p>
        <div class="actions">
          <a class="btn" href={href("/request-access/")}>Request pilot access</a>
          <a class="link" href={href("/roadmap/")}>Read the roadmap</a>
          <a class="link" href={ext.engineSource}>View the source</a>
          <a class="link" href={ext.arboro}>Arboro showcase</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The record, last: what every finished step leaves behind (the illustration moved here from the hero) -->
  <section class="section" id="record">
    <div class="wrap split split--record">
      <div class="record__text">
        <p class="eyebrow">The record</p>
        <h2 class="h2">A record underneath both.</h2>
        <p class="intro">Whatever we touch leaves an entry in a sealed log: what happened, who did it, in what order. You can show it to a parent, a board or an auditor, and they can check it without taking our word for it.</p>
        <p class="small muted record__note">In the Hub, every finished step writes one line like these, sealed against the one before it. Anyone holding the log can re-compute the chain without our help.</p>
        <a class="link" href={href("/roadmap/")}>What is built, and what is not</a>
      </div>
      <RecordChain />
    </div>
  </section>
</Layout>

<style>
  /* ── hero: one column, the headline across the full measure ── */
  .hero { padding-block: clamp(3rem, 6vw, 5.5rem); }
  .hero__copy > :not(.hero__h) { max-width: 46rem; }

  /* hero headline as live: two lines, one ink, weight carries the hierarchy (600 → 350) */
  .hero__h {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 1.8rem + 2.4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -.028em;
    color: var(--ink);
    margin: .4rem 0 1.4rem;
  }
  .hero__h span { display: block; }
  .hero__h2 { font-weight: 350; color: var(--ink); margin-top: 1.4rem; }
  @media (min-width: 1000px) {
    .hero__h { font-size: clamp(2rem, .9rem + 2.6vw, 3.6rem); line-height: 1.08; margin: 0 0 2rem; }
    .hero__h2 { margin-top: 0; }
  }

  .hero__copy > .lede { margin: 0 0 1rem; }
  @media (min-width: 1000px) {
    .hero__copy > .lede { margin: 0; font-size: clamp(.95rem, .9rem + .3vw, 1.06rem); }
  }
  .hero .actions { margin-top: 1.9rem; }

  /* facts under the hero = live .chips: plain mono facts separated by space alone */
  .hero__facts {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem 2rem;
  }
  @media (min-width: 1000px) { .hero__facts { margin-top: clamp(.9rem, 2vh, 1.35rem); max-width: 28rem; } }
  .hero__facts > li { font-family: var(--font-mono); font-size: var(--step--1); font-weight: 400; line-height: 1.9; color: var(--ink-2); }

  /* live entrance: a 10px rise, no fade, staggered */
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * { transform: translateY(10px); animation: pol-up .6s cubic-bezier(.2, .7, .2, 1) forwards; }
    .hero__copy > :nth-child(2) { animation-delay: .06s; }
    .hero__copy > :nth-child(3) { animation-delay: .1s; }
    .hero__copy > :nth-child(4) { animation-delay: .14s; }
    .hero__copy > :nth-child(5) { animation-delay: .18s; }
    @keyframes pol-up { to { transform: none; } }
  }

  /* ── the Hub: text, figure at full width, then the data card ── */
  #hub :global(.hs) { margin-top: 2.4rem; }
  .hub__text { margin-top: 1.6rem; }
  .hub__text .actions { margin-top: 1rem; }
  .hub__text .actions .link { font-weight: 400; letter-spacing: normal; }
  .datanote { margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem); gap: 0; }
  .datanote .eyebrow { color: var(--seal); margin-bottom: 1.25rem; }
  .datanote > p:not(.eyebrow) { color: var(--ink); }
  .datanote .link { margin-top: 1rem; }

  /* ── the record, last and quieter than it was in the hero ── */
  .record__note { margin: 0 0 1.2rem; max-width: 44ch; }
  @media (min-width: 820px) {
    .split--record { grid-template-columns: 1.1fr .9fr; align-items: center; }
    #record :global(.rc) { justify-self: end; }
  }
  #record :global(.rc) { padding: 1rem 1.15rem 1.1rem; max-width: 420px; }
  #record :global(.rc)::before { margin: -1rem -1.15rem 1rem; }
  #record :global(.rc__cap) { margin-bottom: .7rem; }
  #record :global(.rc__e) { padding: .6rem 0; }
  #record :global(.rc__what) { font-size: .9rem; }
  #record :global(.rc__meta), #record :global(.rc__seal) { font-size: .74rem; }
  #record :global(.rc__check) { width: 1.7rem; height: 1.7rem; font-size: .85rem; }
  #record :global(.rc__status) { font-size: .8rem; }
  #record :global(.rc__foot) { margin-top: .8rem; }
</style>
